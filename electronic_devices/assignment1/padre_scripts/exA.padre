
title Homogenous n-type doped silicon

$ Given n=5 and s=9 and student number s338295, we have the following parameters:
$ TYPE: 14 mod 2 = 0 -> n-type
$ DOPING AMOUNT: 9 mod 9 + 1 = 1 -> N = 1e+16
$ x: 14 x 24 = 336 -> x = 336um
$ y: 9 x 6 = 54 -> y = 54um

mesh rect nx=500 ny=10 width=1 outf=mesh

$ Let us now describe how the nodes are placed in the mesh
$ Since there is no junction, we can have the nodes sitting at an equal distance from each other 
x.m  n=1    l=0   r=1
x.m  n=500  l=336 r=1
y.m  n=1    l=0   r=1
y.m  n=10   l=54  r=1

region num=1 ix.l=1 ix.h=500 iy.l=1 iy.h=10 silicon

$ Let us define the electrodes
elec num=1 ix.l=1    ix.h=1    iy.l=1 iy.h=10
elec num=2 ix.l=500  ix.h=500  iy.l=1 iy.h=10

dop reg=1 n.type conc=1e+16 x.l=0 x.r=336 y.top=0 y.bot=54 uniform
plot.1d dop a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=dop

material name=silicon EG300=1.11676 PERMITTIVITY=11.8
system electrons holes newton

$ models temperature=300 
$ solve init
$ plot.1d pot       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=pot
$ plot.1d qfn       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=qfn
$ plot.1d qfp       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=qfp
$ plot.1d band.val  a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=vbiv
$ plot.1d band.cond a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=cbiv
$ plot.1d hole      a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=holeiv
$ plot.1d ele       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=eleiv
$ plot.1d e.field   a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=efieldiv

$ log outfile=bias_IV_char

$ solve vstep=0.1 nsteps=5 elect=1
$ plot.1d pot       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=bias_pot
$ plot.1d qfn       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=bias_qfn
$ plot.1d qfp       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=bias_qfp
$ plot.1d band.val  a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=bias_vbiv
$ plot.1d band.cond a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=bias_cbiv
$ plot.1d e.field   a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=bias_efieldiv

$ log off

models temperature=600
solve init
plot.1d pot       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=htemp_pot
plot.1d qfn       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=htemp_qfp
plot.1d band.val  a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=htemp_vbiv
plot.1d band.cond a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=htemp_cbiv
plot.1d hole      a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=htemp_holeiv
plot.1d ele       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=htemp_eleiv

end