
title Homogenous n-type doped silicon with optical generation

mesh rect nx=500 ny=10 width=1 outf=mesh

$ Let us now describe how the nodes are placed in the mesh
$ Since there is no junction, we can have the nodes sitting at an equal distance from each other 
x.m  n=1    l=0    r=1
x.m  n=500  l=9    r=1
y.m  n=1    l=0    r=1
y.m  n=10   l=54   r=1

region num=1 ix.l=1 ix.h=500 iy.l=1 iy.h=10 silicon

$ Let us define the electrodes
elec num=1 ix.l=1    ix.h=1    iy.l=1 iy.h=10
elec num=2 ix.l=500  ix.h=500  iy.l=1 iy.h=10

dop reg=1 n.type conc=1e+16 x.l=0 x.r=9 y.top=0 y.bot=54 uniform

$ Plot the doping of the semiconductor as a sanity-check
plot.1d dop a.x=0 b.x=9 a.y=27 b.y=27 ascii outf=dop

material name=silicon taun0=1e-06 taup0=1e-06 MUP=446 MUN=1258
system electrons holes newton

models srh temperature=300 
solve init
solve prev gen=9e+20 reg.gen=1 absorp=0 dir.gen=x
plot.1d hole      a.x=0 b.x=9 a.y=27 b.y=27 ascii outf=holeiv
plot.1d ele       a.x=0 b.x=9 a.y=27 b.y=27 ascii outf=eleiv