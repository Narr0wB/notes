
title Asymmetric PN junction under bias 

mesh rect nx=200 ny=3 width=1 outf=mesh
x.m n=1   l=0   r=1
x.m n=100 l=168 r=0.8
x.m n=200 l=336 r=1.2
y.m n=1   l=0   r=1
y.m n=3   l=54  r=1

region num=1 ix.l=1   ix.h=100 iy.l=1 iy.h=3 silicon
region num=2 ix.l=100 ix.h=200 iy.l=1 iy.h=3 silicon

elec num=1 ix.l=1   ix.h=1   iy.l=1 iy.h=3
elec num=2 ix.l=200 ix.h=200 iy.l=1 iy.h=3

dop reg=1 p.type conc=1e+16 uniform
dop reg=2 n.type conc=6e+16 uniform
plot.1d dop a.x=0 b.x=336 a.y=0 b.y=54 ascii outf=dop

material name=silicon taup0=2e-7 taun0=2e-7
system electrons holes newton

models srh temperature=300
solve init
solve prev v1=0.6 elect=1
plot.1d pot       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=pot
plot.1d qfn       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=qfn
plot.1d qfp       a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=qfp
plot.1d band.val  a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=vbiv
plot.1d band.cond a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=cbiv
plot.1d e.field   a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=efieldiv
plot.1d net.ch    a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=netch
plot.1d j.electr  a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=jele
plot.1d j.hole    a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=jhole
plot.1d j.total   a.x=0 b.x=336 a.y=27 b.y=27 ascii outf=jtot

$ log outfile=bias_IV_char

$ solve init
$ solve vstep=-0.1 nsteps=18 elect=1
$ solve vstep=0.1 nsteps=10 elect=1

$ log off

end