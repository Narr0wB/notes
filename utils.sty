\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{utils}[personal utils library]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{titlesec}

\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.15em minus 0.1em}
\setlist{topsep=0.5em, itemsep=0.2em, parsep=0pt, partopsep=0pt}
\titlespacing*{\section}{0pt}{3.5ex plus 1ex minus 0.2ex}{1.5ex plus 0.2ex}
\titlespacing*{\subsection}{0pt}{2.75ex plus 0.8ex minus 0.2ex}{1.1ex plus 0.2ex}
\titlespacing*{\subsubsection}{0pt}{2.25ex plus 0.6ex minus 0.2ex}{0.8ex plus 0.2ex}
\setlength{\emergencystretch}{1em}

\Crefname{theorem}{T.}{T.}
\crefdefaultlabelformat{\textbf{#2#1#3}}

\newcommand{\st}{\mathrel{:}}
\newcommand{\mfrac}[2]{\displaystyle\frac{#1}{#2}}
\newcommand{\abs}[1]{\left\lvert #1 \right\rvert}
\newcommand{\qty}{%
  \@ifnextchar({%
    \qty@paren
  }{%
    \@ifnextchar[{%
      \qty@bracket
    }{%
      \@ifnextchar|{%
        \qty@abs
      }{%
        \qty@brace
      }%
    }%
  }%
}

\newcommand{\pv}[1]{\operatorname{p.v.}\!\left(#1\right)}
\DeclareMathOperator{\PV}{PV}

\NewDocumentCommand{\qty@paren}{r()}{\left(#1\right)}
\NewDocumentCommand{\qty@bracket}{r[]}{\left[#1\right]}
\def\qty@abs|#1|{\left|#1\right|}
\def\qty@brace#1{\left\{#1\right\}}

\newtheoremstyle{catalogue}
    {1em plus 0.25em minus 0.1em}
    {1em plus 0.25em minus 0.1em}
    {\itshape}
    {0pt}
    {\bfseries}
    {.}
    {0.5em}
    {}
\theoremstyle{catalogue}

\newtheorem{axiom}{Assioma}
\newtheorem{theorem}{Teorema}
\newtheorem{corollary}{Corollario}
\newtheorem{osservazione}{Osservazione}
\newtheorem{lemma}{Lemma}
\newtheorem{proposition}{Proposizione}
\newtheorem{definition}{Definizione}
\newtheorem{property}{Proprietà}

